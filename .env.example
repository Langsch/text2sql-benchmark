# --- Anthropic (Claude Sonnet 5 pela API nativa) ----------------------------
ANTHROPIC_API_KEY=
# Opcional: workspace da Anthropic em que as chamadas são cobradas.
ANTHROPIC_WORKSPACE_ID=

# PostgreSQL
POSTGRES_USER=bird
POSTGRES_PASSWORD=bird
POSTGRES_DB=bird
POSTGRES_URL=postgresql://bird:bird@localhost:5432/bird

# MariaDB
MARIADB_USER=bird
MARIADB_PASSWORD=bird
MARIADB_DB=bird
MARIADB_ROOT_PASSWORD=root
MARIADB_URL=mysql+mariadb://bird:bird@localhost:3306/bird

# SQLite (caminho para o diretório com os .db do BIRD)
SQLITE_DB_DIR=./data/bird/dev_databases

# Dataset BIRD (diretório gerado por download_dataset.py)
BIRD_DATA_PATH=./data/bird/by_db
BIRD_USE_EVIDENCE=true

# Benchmark
BENCHMARK_TIMEOUT_SECONDS=30
BENCHMARK_OUTPUT_DIR=./results/runs

# --- OpenRouter (os outros quatro modelos) ----------------------------------
# Ponha crédito em https://openrouter.ai/credits e a chave aqui.
OPENROUTER_API_KEY=

# Provedor upstream fixado por modelo. Sem isso o OpenRouter troca de provedor
# no meio da rodada e o resultado não é reproduzível; o runner recusa a rodada
# se faltar. Os valores abaixo são os usados no experimento do TCC.
# Para conferir quem atende hoje: python cli.py smoke --model <slug>
OPENROUTER_PIN_GOOGLE_GEMINI_3_1_FLASH_LITE=google-ai-studio
OPENROUTER_PIN_QWEN_QWEN3_8_27B=chutes
OPENROUTER_PIN_OPENAI_GPT_5_6_LUNA=openai
OPENROUTER_PIN_DEEPSEEK_DEEPSEEK_V4_FLASH_0731=novita
# Usado só no subteste de equivalência entre rotas (Sonnet via OpenRouter).
OPENROUTER_PIN_ANTHROPIC_CLAUDE_SONNET_5=anthropic

# Quantização exigida dos modelos abertos (a usada no experimento).
OPENROUTER_QUANT_QWEN=fp8
OPENROUTER_QUANT_DEEPSEEK=fp8
