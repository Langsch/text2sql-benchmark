# LLM API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# PostgreSQL
POSTGRES_USER=bird
POSTGRES_PASSWORD=bird
POSTGRES_DB=bird
POSTGRES_URL=postgresql://bird:bird@localhost:5432/bird

# MariaDB
MARIADB_USER=bird
MARIADB_PASSWORD=bird
MARIADB_DB=bird
MARIADB_ROOT_PASSWORD=root
MARIADB_URL=mysql+mariadb://bird:bird@localhost:3306/bird

# SQLite (caminho para o diretório com os .db do BIRD)
SQLITE_DB_DIR=./data/bird/dev_databases

# Dataset BIRD (diretório gerado por download_dataset.py)
BIRD_DATA_PATH=./data/bird/by_db
BIRD_USE_EVIDENCE=true

# Benchmark
BENCHMARK_TIMEOUT_SECONDS=30
BENCHMARK_OUTPUT_DIR=./results/runs
