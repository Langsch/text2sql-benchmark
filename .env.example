# LLM API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# PostgreSQL
POSTGRES_USER=bird
POSTGRES_PASSWORD=bird
POSTGRES_DB=bird
POSTGRES_URL=postgresql://bird:bird@localhost:5432/bird

# MariaDB
MARIADB_USER=bird
MARIADB_PASSWORD=bird
MARIADB_DB=bird
MARIADB_ROOT_PASSWORD=root
MARIADB_URL=mysql+mariadb://bird:bird@localhost:3306/bird

# SQLite (caminho para o diretório com os .db do BIRD)
SQLITE_DB_DIR=./data/bird/dev_databases

# Dataset BIRD (diretório gerado por download_dataset.py)
BIRD_DATA_PATH=./data/bird/by_db
BIRD_USE_EVIDENCE=true

# Benchmark
BENCHMARK_TIMEOUT_SECONDS=30
BENCHMARK_OUTPUT_DIR=./results/runs

# --- OpenRouter -------------------------------------------------------------
# Plataforma unica de acesso aos modelos restantes (a Groq ficou indisponivel).
# Ponha credito em https://openrouter.ai/credits e a chave aqui.
OPENROUTER_API_KEY=

# Provedor upstream fixado por modelo. OBRIGATORIO nos modelos servidos por
# varios provedores — sem isso o OpenRouter troca de provedor no meio da rodada
# e o resultado nao e reproduzivel. O runner recusa a rodada se faltar.
#
# Descubra o valor rodando:  python cli.py smoke --model <slug>
# Ele imprime quem atendeu e ja monta a linha para colar aqui.
OPENROUTER_PIN_DEEPSEEK_DEEPSEEK_V4_FLASH_0731=
OPENROUTER_PIN_QWEN_QWEN3_8_27B=
OPENROUTER_PIN_OPENAI_GPT_5_6_LUNA=

OPENROUTER_PIN_GOOGLE_GEMINI_3_1_FLASH_LITE=
OPENROUTER_PIN_ANTHROPIC_CLAUDE_SONNET_5=

# Quantizacao exigida dos modelos abertos, ex. fp8. Deixar vazio aceita
# qualquer uma — o que so e aceitavel se o provedor estiver fixado acima.
OPENROUTER_QUANT_QWEN=
OPENROUTER_QUANT_DEEPSEEK=
